mount/mac_npu/*.ipynb

# Controller runtime state
logs/*.json
logs/*.tmp
!logs/.gitkeep

# Python and notebook caches
__pycache__/
*.pyc
.ipynb_checkpoints/

# Editor and OS
*.swp
*~
Thumbs.db
.DS_Store
