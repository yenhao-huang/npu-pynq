{
  "id": "006-hexagon-board",
  "ppa": [
    {"name": "hx_l1i_cache", "top": "npu_cache", "generics": ["SIZE_BYTES=1024", "READ_ONLY=1"]},
    {"name": "hx_l1d_cache", "top": "npu_cache", "generics": ["SIZE_BYTES=1024", "WRITE_BACK=1", "CPU_HOLD=1"]},
    {"name": "hx_l2_cache", "top": "npu_cache", "generics": ["SIZE_BYTES=8192", "WAYS=2", "CPU_W=256", "MEM_W=64", "RESP_W=32", "CPU_HOLD=1"]},
    {"name": "hx_npu_mem_arbiter", "top": "npu_mem_arbiter"},
    {"name": "hx_npu_axi4_line_bridge", "top": "npu_axi4_line_bridge"},
    {"name": "hx_subsystem_full", "top": "npu_hx_subsystem", "clock_port": "s_axi_aclk"},
    {"name": "hx_subsystem_no_vector", "top": "npu_hx_subsystem", "generics": ["HX_ENABLE_VECTOR=0"], "clock_port": "s_axi_aclk"},
    {"name": "hx_subsystem_no_l2", "top": "npu_hx_subsystem", "generics": ["HX_ENABLE_L2=0"], "clock_port": "s_axi_aclk"},
    {"name": "hx_subsystem_no_dma", "top": "npu_hx_subsystem", "generics": ["HX_ENABLE_DMA=0"], "clock_port": "s_axi_aclk"},
    {"name": "hx_subsystem_core_only", "top": "npu_hx_subsystem", "generics": ["HX_ENABLE_VECTOR=0", "HX_ENABLE_L2=0", "HX_ENABLE_DMA=0"], "clock_port": "s_axi_aclk"}
  ],
  "overlay": {"mode": "build", "tclargs": "--hexagon"},
  "export": {"cmd": "bash exp/1011_hexagon_npu/export_smollm.sh build/exp-payload"},
  "board": {"script": "exp/1011_hexagon_npu/board/run_hexagon.sh", "timeout_minutes": 120}
}
