FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg cmake ninja-build python3 python3-venv \
    gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
       -o /etc/apt/trusted.gpg.d/apt.llvm.org.asc \
    && echo 'deb https://apt.llvm.org/noble/ llvm-toolchain-noble-22 main' \
       > /etc/apt/sources.list.d/llvm22.list \
    && apt-get update && apt-get install -y --no-install-recommends \
       llvm-22 llvm-22-dev mlir-22-tools libmlir-22-dev lld-22 clang-22 \
    && python3 -m venv /opt/compiler-venv \
    && /opt/compiler-venv/bin/pip install numpy==1.26.4 onnx==1.17.0
ENV PATH=/opt/compiler-venv/bin:/usr/lib/llvm-22/bin:$PATH
ENV NPU_LLVM_BIN=/usr/lib/llvm-22/bin
ENV CMAKE_GENERATOR=Ninja
ENV NPU_OPT_BUILD=/repo/build/official-npu-opt
ENV NPU_BUILD_JOBS=2
WORKDIR /repo
